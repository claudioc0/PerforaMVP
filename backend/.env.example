# Copie este arquivo para .env e preencha com seus valores reais.
# Nunca commite o .env de verdade — ele já está no .gitignore.

# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
JWT_SECRET_KEY=

# "development" habilita o modo debug do Flask (console interativo do Werkzeug
# em qualquer erro — execução remota de código se isso for exposto). Qualquer
# outro valor (ou ausência da variável) assume produção por segurança.
#
# O padrão aqui é "production" DE PROPÓSITO: este arquivo existe pra ser
# copiado. Se ele viesse com "development" e alguém esquecesse de trocar essa
# linha ao copiar pra um servidor de verdade, o debug ficaria exposto por
# padrão. Rodando localmente, troque para "development" você mesmo.
FLASK_ENV=production

# Origens permitidas por CORS, separadas por vírgula.
# "*" só é seguro em desenvolvimento local.
CORS_ORIGINS=*

# Chave da API do Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-1.5-flash-latest

# Chave Fernet para criptografia de dados sensíveis em repouso.
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Opcional — string de conexão do banco. Sem isso, usa SQLite local em instance/nutrition.db
# DATABASE_URL=

# Opcional — storage do Flask-Limiter. "memory://" serve para um único processo (MVP).
# RATELIMIT_STORAGE_URI=memory://
