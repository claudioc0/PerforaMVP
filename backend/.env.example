# Copie este arquivo para .env e preencha com seus valores reais.
# Nunca commite o .env de verdade — ele já está no .gitignore.

# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
JWT_SECRET_KEY=

# "development" habilita o modo debug do Flask (console interativo do Werkzeug
# em qualquer erro — execução remota de código se isso for exposto). Qualquer
# outro valor (ou ausência da variável) assume produção por segurança.
#
# O padrão aqui é "production" DE PROPÓSITO: este arquivo existe pra ser
# copiado. Se ele viesse com "development" e alguém esquecesse de trocar essa
# linha ao copiar pra um servidor de verdade, o debug ficaria exposto por
# padrão. Rodando localmente, troque para "development" você mesmo.
FLASK_ENV=production

# Origens permitidas por CORS, separadas por vírgula (ex:
# "https://meuapp.com,https://admin.meuapp.com"). Deixe em branco/comentado
# pra usar o padrão: "*" em desenvolvimento (FLASK_ENV=development), fechado
# (nenhuma origem) em produção — o app mobile não é afetado, CORS só existe
# pra navegadores. Só defina "*" aqui de propósito, nunca como esquecimento.
# CORS_ORIGINS=*

# Chave da API do Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-1.5-flash-latest

# Chave Fernet para criptografia de dados sensíveis em repouso.
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Opcional — string de conexão do banco. Sem isso, usa SQLite local em
# instance/nutrition.db — só aguenta um punhado de usuários simultâneos
# (escritor único do arquivo). Pra produção com mais tráfego, aponte pra um
# Postgres de verdade (psycopg2-binary já está no requirements.txt):
# DATABASE_URL=postgresql://usuario:senha@host:5432/nome_do_banco
#
# Só usados quando DATABASE_URL é Postgres (tamanho do pool de conexões):
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10

# Opcional — storage do Flask-Limiter. "memory://" (padrão) só é correto com
# um único processo — o Procfile já fixa isso (--workers 1 --threads 4). Se
# for rodar com mais de 1 worker/instância, defina um storage compartilhado
# (ex: "redis://localhost:6379") e instale o cliente correspondente
# (`pip install redis`).
# RATELIMIT_STORAGE_URI=memory://

# A blocklist de tokens revogados (logout) é limpa automaticamente a cada
# logout (remove entradas já expiradas). Como rede de segurança extra pra
# apps com pouco tráfego de logout, agende `flask cleanup-expired-tokens`
# como cron job (ex: diário) no ambiente de produção.
